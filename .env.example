# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp: solo dígitos con código de país, p. ej. 5939XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Proxy de confianza para detectar la IP del cliente (rate limit):
# vercel | cloudflare | other (usa la entrada más a la derecha de x-forwarded-for) | none (por defecto)
TRUSTED_PROXY=none

# Resend (https://resend.com) — envío del formulario de contacto
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Remitente verificado en Resend, p. ej. "Zentinel Labs <contacto@tu-dominio.com>"
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile. Claves de PRUEBA (siempre pasan) para desarrollo:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Opcional — rate limit compartido (obligatorio en hosting serverless)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
